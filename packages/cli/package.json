{
  "name": "agentreplay",
  "version": "0.1.0",
  "description": "Turn a Claude Code session into a self-contained HTML replay of how the agent worked \u2014 locally, with no telemetry.",
  "keywords": [
    "claude-code",
    "claude",
    "ai",
    "agent",
    "session",
    "replay",
    "transcript",
    "visualization",
    "cli",
    "local-first",
    "developer-tools"
  ],
  "license": "MIT",
  "author": "Aarav Khanduja",
  "homepage": "https://github.com/AaravKhanduja/agentreplay#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AaravKhanduja/agentreplay.git",
    "directory": "packages/cli"
  },
  "bugs": {
    "url": "https://github.com/AaravKhanduja/agentreplay/issues"
  },
  "type": "module",
  "bin": {
    "agentreplay": "./dist/index.js"
  },
  "files": [
    "dist",
    "assets",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsup && node scripts/copy-assets.mjs",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "cd ../.. && pnpm build"
  },
  "dependencies": {
    "@inquirer/prompts": "^8.7.0",
    "commander": "^12.1.0"
  },
  "devDependencies": {
    "@agentreplay/core": "workspace:*",
    "@types/node": "^20.14.0",
    "tsup": "^8.2.4",
    "tsx": "^4.16.5",
    "typescript": "^5.5.4"
  }
}
